# Copy to .env only for local development. Never commit the populated file.
APP_ENV=development
PROJECT_NAME=Sinfreno API
# Required: PostgreSQL URL. Supply credentials locally; percent-encode its password.
DATABASE_URL=
# Required: generate a private random key with at least 32 characters.
# Example command (prints a new key locally): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
