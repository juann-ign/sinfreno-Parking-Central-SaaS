# Public connection configuration; never put credentials or tokens in VITE_*.
# Development default (may include a reverse-proxy prefix, e.g. /sinfreno):
VITE_BACKEND_URL=http://localhost:8000

# Optional route overrides. The defaults append /api/v1 and /ws to BACKEND_URL.
# HTTP/HTTPS websocket overrides are converted to WS/WSS automatically.
# VITE_API_BASE_URL=https://parking.example/sinfreno/api/v1
# VITE_WS_BASE_URL=wss://parking.example/sinfreno/ws

# Root-relative values inherit the frontend origin and TLS scheme:
# VITE_BACKEND_URL=/sinfreno
# Restart Vite after changing .env.local; rebuild for a built frontend.
